# P-Insight Backend — Environment Variables
# -------------------------------------------
# Copy this file to .env and fill in real values before running.
# Never commit your actual .env file to version control.
#
# Runtime policy: ../docs/RUNTIME_SAFETY.md. This is a LOCAL example, not production approval.

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=P-Insight API
APP_VERSION=0.1.0

# "development" | "test" | "staging" | "production"; unknown names fail startup.
APP_ENV=development

# Set to false in production — SQL echo + stack traces are exposed when true
DEBUG=false

# ─── Logging ─────────────────────────────────────────────────────────────────
# "DEBUG" | "INFO" | "WARNING" | "ERROR"
LOG_LEVEL=INFO

# ─── API Docs ────────────────────────────────────────────────────────────────
# Set to true to enable /docs and /redoc (Swagger UI).
# Includes /openapi.json; must be false in staging/production.
DOCS_ENABLED=false

# ─── CORS ────────────────────────────────────────────────────────────────────
# Option A — single origin (simple local setup):
FRONTEND_URL=http://localhost:3000

# Option B — comma-separated list (multi-origin / production):
# ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
# JSON lists also work: ALLOWED_ORIGINS=["https://app.example.com"]
# Exact origins only: no paths, credentials, queries, wildcards or empty list items.
# Staging/production require HTTPS, non-local origins; localhost is never auto-added.

# ─── Auth & Tenancy (Supabase) ────────────────────────────────────────────────
# false is local/test legacy single-user mode only; staging/production require true.
# Staging/production require an HTTPS SUPABASE_URL; ES256/RS256 need no shared secret.
AUTH_ENABLED=false
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUD=authenticated

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (development — no setup required):
DATABASE_URL=sqlite:///./p_insight.db
# Explicitly allow local SQLite create_all/additive bootstrap. Never permitted remotely.
LOCAL_DB_BOOTSTRAP=true

# PostgreSQL (required in staging/production):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/p_insight
# Use the locked dependency install, set LOCAL_DB_BOOTSTRAP=false and run alembic upgrade head.
# Managed startup verifies the migration stamp read-only; it never upgrades schema.

# ─── Default Data Mode ───────────────────────────────────────────────────────
# "uploaded" | "live" | "broker" (mock mode is disabled)
DEFAULT_DATA_MODE=uploaded

# ─── Feature Flags ───────────────────────────────────────────────────────────
LIVE_API_ENABLED=true
BROKER_SYNC_ENABLED=false
AI_CHAT_ENABLED=false
ADVANCED_ANALYTICS_ENABLED=false

# Modular feature switches. Disable one feature without taking down the app.
FEATURE_PORTFOLIO_CORE=true
FEATURE_UPLOAD=true
FEATURE_WATCHLIST=true
FEATURE_QUANT=true
FEATURE_FUNDAMENTALS=true
FEATURE_HISTORY=true
FEATURE_MARKET_DATA=true
FEATURE_NEWS=true
FEATURE_ADVISOR=true
FEATURE_BROKER_SYNC=false

# ─── AI Provider Keys ────────────────────────────────────────────────────────
# Provide at least one key to enable the AI Portfolio Advisor.
# Claude (Anthropic) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com
OPENAI_API_KEY=

# ─── Market Data Keys (all optional) ─────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=
FINANCIAL_MODELING_PREP_API_KEY=
NEWS_API_KEY=

# ─── Broker Integration (scaffolded — not yet implemented) ───────────────────
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
